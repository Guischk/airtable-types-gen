# Supply-chain hardening for pnpm. See https://pnpm.io/settings

# Refuse any package version published less than 3 days ago. Compromised
# releases from npm account takeovers are typically yanked within hours, so
# this window absorbs the bulk of them before they can reach a lockfile.
minimum-release-age=4320

# Fail loudly if the lockfile does not match package.json rather than silently
# resolving something new.
prefer-frozen-lockfile=true

# Dependency lifecycle scripts stay blocked (pnpm's default since v10); the
# allowlist lives in pnpm.onlyBuiltDependencies in package.json and is empty.
